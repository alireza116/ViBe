{
  "name": "elicit-js",
  "version": "0.1.0",
  "description": "Declarative, grammar-of-graphics-inspired library for interactive visual belief elicitation.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./dist": {
      "types": "./src/index.d.ts",
      "import": "./dist/elicit.js",
      "default": "./dist/elicit.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev docs-next",
    "build:docs": "next build docs-next",
    "start:docs": "next start docs-next",
    "build:lib": "vite build --config vite.lib.config.js",
    "typecheck": "tsc --noEmit",
    "verify:browser": "node scripts/verify-browser.mjs",
    "check:warnings": "node scripts/check-warnings.mjs"
  },
  "keywords": [
    "visualization",
    "dataviz",
    "elicitation",
    "belief-elicitation",
    "interactive",
    "grammar-of-graphics",
    "d3",
    "svg"
  ],
  "author": "Alireza Karduni",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alireza116/ViBe.git"
  },
  "homepage": "https://github.com/alireza116/ViBe#readme",
  "bugs": {
    "url": "https://github.com/alireza116/ViBe/issues"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^15.5.20",
    "@types/d3": "^7.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "next": "^15.5.20",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-live": "^4.1.8",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
