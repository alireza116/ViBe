{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    // No ambient @types packages. The library targets the browser and must not
    // typecheck against Node or Vite globals it won't have at runtime — that is
    // exactly how the old `import.meta.env.DEV` guards passed tsc while being dead
    // in every non-Vite consumer. The one deliberate exception is the guarded
    // `process.env.NODE_ENV` read in core/dev.js, which carries a local @ts-ignore.
    "types": []
  },
  "include": ["src/**/*"]
}
